<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <Id>92372286-135c-43f7-b79c-8723fee81d31</Id>

  <!-- !!! IMPORTANT: bump this every time you change the manifest -->
  <Version>1.0.1.0</Version>

  <ProviderName>PierreLarno</ProviderName>
  <DefaultLocale>fr-FR</DefaultLocale>

  <DisplayName DefaultValue="Aligner une image à droite avec du texte à gauche"/>
  <Description DefaultValue="Complément Word pour l'exercice image à droite / texte à gauche."/>

  <!-- No double slashes -->
  <IconUrl DefaultValue="https://pierrelarno.github.io/EssaiAddin01/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://pierrelarno.github.io/EssaiAddin01/assets/icon-64.png"/>

  <SupportUrl DefaultValue="https://pierrelarno.github.io/EssaiAddin01/"/>

  <!-- AppDomains: NO wildcards. Only domains you actually load -->
  <AppDomains>
    <AppDomain>https://pierrelarno.github.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document"/>
  </Hosts>

  <!-- Taskpane default page -->
  <DefaultSettings>
    <SourceLocation DefaultValue="https://pierrelarno.github.io/EssaiAddin01/images.html"/>
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xsi:type="VersionOverridesV1_0" xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>

          <!-- Ribbon (3 dots > group > button). FunctionFile must exist and be reachable -->
          <FunctionFile resid="Commands.Url"/>

          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="CommandsGroup">
                <Label resid="CommandsGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>

                <Control xsi:type="Button" id="TaskpaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>

              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://pierrelarno.github.io/EssaiAddin01/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://pierrelarno.github.io/EssaiAddin01/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://pierrelarno.github.io/EssaiAddin01/assets/icon-80.png"/>
      </bt:Images>

      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://go.microsoft.com/fwlink/?LinkId=276812"/>
        <!-- commands.html MUST exist at this path in your GitHub Pages site -->
        <bt:Url id="Commands.Url"           DefaultValue="https://pierrelarno.github.io/EssaiAddin01/commands.html"/>
        <bt:Url id="Taskpane.Url"           DefaultValue="https://pierrelarno.github.io/EssaiAddin01/images.html"/>
      </bt:Urls>

      <bt:ShortStrings>
        <bt:String id="GetStarted.Title"     DefaultValue="Démarrer le complément"/>
        <bt:String id="CommandsGroup.Label"  DefaultValue="Exercice"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Ouvrir l'exercice"/>
      </bt:ShortStrings>

      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Cliquez sur le bouton du ruban pour ouvrir le panneau du complément."/>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Ouvrir le panneau de l'exercice"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
